<!DOCTYPE html>
<html lang="{{ request.locale.iso_code }}" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ shop.name }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;400;500&amp;family=Assistant:wght@200;300;400;600&amp;display=swap" rel="stylesheet">
{{ 'theme.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body>
<div class="statement" style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px">
  <div class="wordmark" style="color:var(--paper);font-size:32px;margin-bottom:28px">{{ shop.name }}</div>
  {{ content_for_layout }}
</div>
</body>
</html>
