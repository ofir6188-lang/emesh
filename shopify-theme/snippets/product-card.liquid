{%- comment -%}
  Renders one product tile in the museum-label grid style.
  Accepts: product, fig_label (string)
{%- endcomment -%}
<article class="item reveal">
  <a href="{{ product.url }}" class="frame" data-slot="{{ fig_label }}">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 1200 | image_tag:
        loading: 'lazy',
        widths: '450, 700, 900, 1200',
        sizes: '(max-width:760px) 50vw, 25vw',
        alt: product.featured_media.alt | default: product.title
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {%- endif -%}
    {%- if product.available == false -%}
      <span class="sold-out-badge">{{ 'products.product.sold_out' | t }}</span>
    {%- endif -%}
  </a>
  <div class="label">
    <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- render 'price', product: product -%}
  </div>
</article>
