<p style="color:var(--paper);font-size:14px;margin-bottom:20px;max-width:40ch">האתר עדיין לא פתוח לציבור. הזינו סיסמה כדי להציץ.</p>
{% form 'storefront_password' %}
  {%- if form.errors -%}
    <p style="color:#E7A38C;font-size:13px;margin-bottom:12px">{{ form.errors.messages['form'] }}</p>
  {%- endif -%}
  <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
    <input type="password" name="password" placeholder="סיסמה" aria-label="סיסמה" style="padding:10px 12px;border:1px solid rgba(242,241,236,.4);background:none;color:var(--paper);font-family:var(--body);font-size:14px">
    <button type="submit" class="cta" style="color:var(--paper);border-color:var(--paper)">כניסה</button>
  </div>
{% endform %}

{% schema %}
{ "name": "טופס סיסמה", "settings": [] }
{% endschema %}
