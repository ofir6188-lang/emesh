<section class="values">
  {%- for block in section.blocks -%}
    <div class="value reveal" {{ block.shopify_attributes }}>
      <span class="num">{{ block.settings.number }}</span>
      <h3>{{ block.settings.heading }}</h3>
      <p>{{ block.settings.text }}</p>
    </div>
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "ערכי מותג",
  "blocks": [
    {
      "type": "value",
      "name": "ערך",
      "settings": [
        { "type": "text", "id": "number", "label": "מספר", "default": "01" },
        { "type": "text", "id": "heading", "label": "כותרת" },
        { "type": "textarea", "id": "text", "label": "טקסט" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "value", "settings": { "number": "01", "heading": "כסף 925 אמיתי", "text": "כסף סטרלינג באיכות גבוהה, עם תעודת אותנטיות לכל תכשיט." } },
      { "type": "value", "settings": { "number": "02", "heading": "ייצור מוגבל", "text": "כל סדרה מוגבלת למאה יחידות. כשהן אוזלות, הן אוזלות עד לסדרה הבאה." } },
      { "type": "value", "settings": { "number": "03", "heading": "עשוי לעשור", "text": "כל חוליה מולחמת ביד, לא רק מהודקת — מצופה רודיום כדי שיישאר מבריק שנים." } }
    ]
  }
}
{% endschema %}
