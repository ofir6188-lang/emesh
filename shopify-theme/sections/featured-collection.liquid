<section class="collection" id="{{ section.settings.anchor_id | default: 'collection' }}">
  {%- if section.settings.show_heading -%}
    <div class="rule">
      <span>{{ section.settings.heading }}</span>
      <span>{{ section.settings.collection.products_count }} {{ 'collections.general.items_count' | t }} · {{ 'collections.general.in_stock' | t }}</span>
    </div>
  {%- endif -%}
  <div class="grid">
    {%- assign fig_start = section.settings.fig_start | default: 2 -%}
    {%- for product in section.settings.collection.products limit: section.settings.limit offset: section.settings.offset -%}
      {%- assign fig_number = fig_start | plus: forloop.index0 -%}
      {%- if fig_number < 10 -%}{%- assign fig_label = 'FIG. 0' | append: fig_number -%}{%- else -%}{%- assign fig_label = 'FIG. ' | append: fig_number -%}{%- endif -%}
      {%- render 'product-card', product: product, fig_label: fig_label -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "אוסף מוצג",
  "settings": [
    { "type": "collection", "id": "collection", "label": "אוסף" },
    { "type": "checkbox", "id": "show_heading", "label": "הצג כותרת", "default": true },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "האוסף" },
    { "type": "text", "id": "anchor_id", "label": "עוגן (id)", "default": "collection" },
    { "type": "range", "id": "limit", "min": 1, "max": 12, "step": 1, "label": "כמות מוצרים", "default": 3 },
    { "type": "range", "id": "offset", "min": 0, "max": 24, "step": 1, "label": "דלג על N מוצרים ראשונים", "default": 0 },
    { "type": "range", "id": "fig_start", "min": 1, "max": 20, "step": 1, "label": "מספר FIG. התחלתי", "default": 2 }
  ],
  "presets": [{ "name": "אוסף מוצג" }]
}
{% endschema %}
