<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <div class="wordmark" style="text-align:right">{{ shop.name }}</div>
      <p>{{ section.settings.blurb }}</p>
    </div>
    <div class="footer-col">
      <h4>חנות</h4>
      {%- for link in section.settings.shop_menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
    <div class="footer-col">
      <h4>מידע</h4>
      {%- for link in section.settings.info_menu.links -%}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </div>
    <div class="footer-col">
      <h4>עקבו</h4>
      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}">אינסטגרם</a>
      {%- endif -%}
      {%- if settings.social_pinterest_link != blank -%}
        <a href="{{ settings.social_pinterest_link }}">פינטרסט</a>
      {%- endif -%}
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>כל הזכויות שמורות</span>
  </div>
</footer>

{% schema %}
{
  "name": "פוטר",
  "settings": [
    {
      "type": "richtext",
      "id": "blurb",
      "label": "תיאור קצר",
      "default": "<p>אוסף תכשיטי כסף קטן, מעוצב ביד ביפו. מיוצר לפי דרישה, בלי מלאי עודף.</p>"
    },
    {
      "type": "link_list",
      "id": "shop_menu",
      "label": "תפריט 'חנות'",
      "default": "footer"
    },
    {
      "type": "link_list",
      "id": "info_menu",
      "label": "תפריט 'מידע'",
      "default": "footer"
    }
  ]
}
{% endschema %}
