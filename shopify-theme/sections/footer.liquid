<footer>
  <div class="footer-grid">
    <div class="footer-brand">
      <div class="wordmark" style="text-align:right">{{ shop.name }}</div>
      <p>{{ section.settings.blurb }}</p>
    </div>
    <div class="footer-col">
      <h4>חנות</h4>
      <a href="{{ routes.all_products_collection_url }}">האוסף</a>
      <a href="{{ routes.root_url }}#atelier">המלאכה</a>
      <a href="{{ routes.root_url }}#about">הסיפור</a>
    </div>
    <div class="footer-col">
      <h4>מידע</h4>
      {%- for policy in shop.policies -%}
        <a href="{{ policy.url }}">{{ policy.title }}</a>
      {%- endfor -%}
      {%- if section.settings.contact_email != blank -%}
        <a href="mailto:{{ section.settings.contact_email }}">צור קשר</a>
      {%- endif -%}
    </div>
    <div class="footer-col">
      <h4>עקבו</h4>
      {%- if settings.social_instagram_link != blank -%}
        <a href="{{ settings.social_instagram_link }}">אינסטגרם</a>
      {%- endif -%}
      {%- if settings.social_pinterest_link != blank -%}
        <a href="{{ settings.social_pinterest_link }}">פינטרסט</a>
      {%- endif -%}
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
    <span>כל הזכויות שמורות</span>
  </div>
</footer>

{% schema %}
{
  "name": "פוטר",
  "settings": [
    {
      "type": "richtext",
      "id": "blurb",
      "label": "תיאור קצר",
      "default": "<p>אוסף תכשיטי כסף קטן, מעוצב ביד ביפו. מיוצר לפי דרישה, בלי מלאי עודף.</p>"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "אימייל ליצירת קשר"
    }
  ]
}
{% endschema %}
