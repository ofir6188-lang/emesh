<section class="categories">
  {%- if section.settings.heading != blank -%}
    <h2 class="categories-heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <div class="categories-grid">
    {%- for block in section.blocks -%}
      <a href="{{ block.settings.link | default: '#collection' }}" class="category-tile" {{ block.shopify_attributes }}>
        <div class="category-tile-media">
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 800 | image_tag:
              loading: 'lazy',
              widths: '400, 600, 800',
              sizes: '(max-width:760px) 90vw, 30vw',
              alt: block.settings.title
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        <span class="category-tile-label">{{ block.settings.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "קטגוריות",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "לפי קטגוריה" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "קטגוריה",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "תמונה" },
        { "type": "text", "id": "title", "label": "שם" },
        { "type": "url", "id": "link", "label": "קישור" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "category", "settings": { "title": "שרשראות" } },
      { "type": "category", "settings": { "title": "צמידים" } },
      { "type": "category", "settings": { "title": "תליונים" } }
    ]
  }
}
{% endschema %}
